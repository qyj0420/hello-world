<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    雄新电力 · 雄新 OWTS — press-only OwtsServices for the Xpert Desktop shell.
    OwtsServices.FactoryPress.g.cs is generated from vendor/factory-press/Xiongxin.Owts.HostAdapters/OwtsServices.cs
    by tools/extract-owts-factorypress.py (members copied byte-for-byte). The remaining
    HostAdapters files are compiled unchanged by link.
  -->
  <PropertyGroup>
    <RootNamespace>Xiongxin.Owts.HostAdapters</RootNamespace>
    <AssemblyName>Xiongxin.Owts.HostAdapters.FactoryPress</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OwtsServices.FactoryPress.g.cs" />
    <Compile Include="$(FactoryPressVendor)\Xiongxin.Owts.HostAdapters\OwtsRuntimeOptions.cs" Link="HostAdapters\OwtsRuntimeOptions.cs" />
    <Compile Include="$(FactoryPressVendor)\Xiongxin.Owts.HostAdapters\PdCalibrationStore.cs" Link="HostAdapters\PdCalibrationStore.cs" />
    <Compile Include="$(FactoryPressVendor)\Xiongxin.Owts.HostAdapters\BenchCalibrationEditor.cs" Link="HostAdapters\BenchCalibrationEditor.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(FactoryPressVendor)\Xiongxin.Owts.Contracts\Xiongxin.Owts.Contracts.csproj" />
    <ProjectReference Include="$(FactoryPressVendor)\Xiongxin.Owts.Acquisition\Xiongxin.Owts.Acquisition.csproj" />
  </ItemGroup>
</Project>
