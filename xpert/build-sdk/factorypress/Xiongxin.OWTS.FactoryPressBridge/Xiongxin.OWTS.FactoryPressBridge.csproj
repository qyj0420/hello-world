<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    雄新电力 · 雄新 OWTS — FactoryPress backend for the Xpert 加压测试 page.
    The Xpert host loads the net48 build by reflection from modules/FactoryPressOwts/.
  -->
  <PropertyGroup>
    <RootNamespace>Xiongxin.OWTS.FactoryPressBridge</RootNamespace>
    <AssemblyName>Xiongxin.OWTS.FactoryPressBridge</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xiongxin.Owts.HostAdapters.FactoryPress\Xiongxin.Owts.HostAdapters.FactoryPress.csproj" />
    <ProjectReference Include="$(FactoryPressVendor)\Xiongxin.Owts.Contracts\Xiongxin.Owts.Contracts.csproj" />
    <ProjectReference Include="$(FactoryPressVendor)\Xiongxin.Owts.Acquisition\Xiongxin.Owts.Acquisition.csproj" />
  </ItemGroup>
</Project>
